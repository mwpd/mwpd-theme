{
  "name": "mwpd/mwpd-theme",
  "description": "Theme for the homepage of the MWPD project.",
  "type": "wordpress-theme",
  "license": "MIT",
  "authors": [
    {
      "name": "Alain Schlesser",
      "email": "alain.schlesser@gmail.com"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0 || ^9.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-stubs/wordpress-stubs": "^6",
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^1.12",
    "roave/security-advisories": "dev-master",
    "sirbrillig/phpcs-variable-analysis": "^2.12",
    "squizlabs/php_codesniffer": "^3.13",
    "vimeo/psalm": "^5",
    "wp-coding-standards/wpcs": "^3"
  },
  "autoload": {
    "psr-4": {
      "MWPD\\MwpdTheme\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MWPD\\MwpdTheme\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "cbf": "phpcbf",
    "cs": "if [ -z $TEST_SKIP_PHPCS ]; then phpcs; fi",
    "lint": "if [ -z $TEST_SKIP_LINTING ]; then parallel-lint -j 10 --colors --exclude vendor .; fi",
    "test": [
      "@lint",
      "@unit",
      "@cs",
      "@analyze"
    ],
    "analyze": "if [ -z $TEST_SKIP_PHPSTAN ]; then phpstan analyze --ansi --memory-limit=1G; fi",
    "unit": "if [ -z $TEST_SKIP_PHPUNIT ]; then phpunit --colors=always; fi"
  }
}
